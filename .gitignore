# ==============================================================================
# Banthry Courtroom - Git Ignore Configuration
# Protects all credentials, secrets, build artifacts and local environments
# ==============================================================================

# Secrets & Environment Files (CRITICAL: NEVER COMMIT)
.env
.env.*
*.env
backend/.env
backend/.env.*
*.pem
*.key
*credential*.json
*service_account*.json
*.secret

# Python Virtual Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.installed.cfg
*.egg

# Node.js & Frontend dependencies
node_modules/
web/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# macOS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Editor & IDE Directories
.idea/
.vscode/
.claude/
*.swp
*.swo

# Temporary scratch & log directories
tmp/
*.log
